{
  "ci": {
    "collect": {
      "startServerCommand": "bash scripts/lighthouse_server.sh",
      "startServerReadyPattern": "Uvicorn running on http://127.0.0.1:8000",
      "url": ["http://127.0.0.1:8000/", "http://127.0.0.1:8000/#trips"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", {"minScore": 0.95}],
        "categories:best-practices": ["error", {"minScore": 0.95}],
        "categories:performance": ["warn", {"minScore": 0.85}]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
